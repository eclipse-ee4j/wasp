<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
    child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The modules inherit the url and scm URLs as they are, without their artifactId appended to them, as they are
        all in this repository (child.*.inherit.append.path).
    -->

    <parent>
        <groupId>org.eclipse.ee4j</groupId>
        <artifactId>project</artifactId>
        <version>2.0.6</version>
        <relativePath/>
    </parent>

    <groupId>org.glassfish.wasp</groupId>
    <artifactId>parent</artifactId>
    <version>4.0.4</version>
    <packaging>pom</packaging>

    <name>WaSP - Parent</name>
    <description>Eclipse compatible implementation of Jakarta Server Pages</description>
    <url>https://projects.eclipse.org/projects/ee4j.wasp</url>

    <developers>
        <developer>
            <id>jakarta-ee4j-wasp</id>
            <name>WaSP Developers</name>
            <organization>Eclipse Foundation</organization>
            <email>wasp-dev@eclipse.org</email>
        </developer>
    </developers>
    <contributors>
       <contributor>
           <name>WaSP Contributors</name>
           <email>wasp-dev@eclipse.org</email>
           <url>https://github.com/eclipse-ee4j/wasp/graphs/contributors</url>
       </contributor>
    </contributors>

    <mailingLists>
        <mailingList>
            <name>Jakarta Server Pages dev mailing list</name>
            <post>wasp-dev@eclipse.org</post>
            <subscribe>https://dev.eclipse.org/mailman/listinfo/wasp-dev</subscribe>
            <unsubscribe>https://dev.eclipse.org/mailman/listinfo/wasp-dev</unsubscribe>
            <archive>https://dev.eclipse.org/mhonarc/lists/wasp-dev</archive>
        </mailingList>
    </mailingLists>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/eclipse-ee4j/wasp.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/eclipse-ee4j/wasp.git</developerConnection>
        <url>https://github.com/eclipse-ee4j/wasp</url>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <system>github</system>
        <url>https://github.com/eclipse-ee4j/wasp/issues</url>
    </issueManagement>

    <properties>
        <!--
            Not published by the central-publishing-maven-plugin (comma separated artifactIds): the TCK runner, the
            benchmark and the tests of the Quarkus extension, and the parent POMs, which the flattened POMs of the
            published jars don't refer to. That plugin publishes in place of the maven-deploy-plugin, and doesn't look
            at maven.deploy.skip.
        -->
        <excludeArtifacts>parent,quarkus-wasp-parent,wasp-tck,wasp-pages-tck,wasp-pages-tck-install,wasp-pages-tck-run,wasp-tags-tck,wasp-benchmark,wasp-quarkus-test</excludeArtifacts>
    </properties>

    <modules>
        <module>impl</module>
        <module>quarkus</module>
        <module>tck</module>
        <module>benchmark</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    For mvn versions:set -DnewVersion=..., which sets the version of this project and, through their
                    parent, of all modules.
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.23.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Sets minimal Maven version to 3.9.9 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.9.9</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Generate a "consumer pom" for the generated jar -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                </configuration>
                <executions>
                    <!-- enable flattening -->
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <!-- ensure proper cleanup -->
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
