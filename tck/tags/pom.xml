<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.glassfish.wasp</groupId>
        <artifactId>wasp-tck</artifactId>
        <version>4.0.4</version>
    </parent>

    <artifactId>wasp-tags-tck</artifactId>
    <!--
        No main classes, so no jar: the tests come from the TCK jar, which the failsafe execution below scans. The test
        classes it does have (the database) are compiled by the executions below.
    -->
    <packaging>pom</packaging>

    <name>WaSP - Jakarta Tags TCK</name>
    <description>
        Runs the Jakarta Tags TCK against WaSP's Jakarta Tags implementation on GlassFish (the default), with
        GlassFish's WaSP jar replaced by this build's. With -Pquarkus (or -Pquarkus-native) it runs the TCK on Quarkus
        with the WaSP extension instead: each test archive is built into a Quarkus application by the Arquillian
        Quarkus container. With -Pglassfish-embedded it runs the TCK on GlassFish Embedded, in the JVM of the tests,
        with this build's WaSP jar before GlassFish's. With -Ppiranha-micro it runs the TCK on Piranha Micro, in the
        JVM of the tests, with Micro's WaSP jar replaced by this build's. With -Ppiranha-webprofile it runs it on the
        Piranha Web Profile distribution, a process for each test archive, with this build's WaSP jar before
        Piranha's.
    </description>

    <properties>
        <jakarta.tck.tags.version>11.0.3</jakarta.tck.tags.version>
        <!-- The WaSP build under test: its Quarkus extension, or the WaSP jar GlassFish uses -->
        <wasp.version>${project.version}</wasp.version>

        <!--
            The database of the SQL tests, which the tests start (see JstlDatabase), and the client driver the pages
            connect to it with: Derby, as in GlassFish (8.0.5), which needs Java 21.
        -->
        <derby.version>10.17.1.0</derby.version>
        <jstl.db.port>1527</jstl.db.port>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.12.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>1.10.0.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Jakarta Tags TCK -->
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>tags-tck</artifactId>
            <version>${jakarta.tck.tags.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- For JstlDatabase, which the JUnit launcher starts and stops -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The database server JstlDatabase starts, and the client it creates the tables with -->
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derbynet</artifactId>
            <version>${derby.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derbyclient</artifactId>
            <version>${derby.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Bound explicitly, as the pom packaging doesn't: compile JstlDatabase and copy its resources -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>test-resources</id>
                        <goals>
                            <goal>testResources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>21</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <dependenciesToScan>
                        <dependenciesToScan>jakarta.tck:tags-tck</dependenciesToScan>
                    </dependenciesToScan>
                    <systemPropertyVariables>
                        <!--
                            The database of the SQL tests. The tests send these to the pages, as request headers, which
                            connect to it with them.
                        -->
                        <jstl.db.server>localhost</jstl.db.server>
                        <jstl.db.port>${jstl.db.port}</jstl.db.port>
                        <jstl.db.url>jdbc:derby://localhost:${jstl.db.port}/memory:jstl</jstl.db.url>
                        <jstl.db.driver>org.apache.derby.client.ClientAutoloadedDriver</jstl.db.driver>
                        <jstl.db.user>cts1</jstl.db.user>
                        <jstl.db.password>cts1</jstl.db.password>
                        <derby.stream.error.file>${project.build.directory}/derby.log</derby.stream.error.file>

                        <!--
                            WaSP parses and transforms XML with secure processing, which restricts the external DTDs
                            and stylesheets XML may refer to, to those that these properties allow. The tests refer to
                            them by relative URLs, which are http URLs on the server. These are for the runtimes that
                            run in the JVM of the tests; the profiles of the others set them in the runtime's JVM.
                        -->
                        <javax.xml.accessExternalDTD>file,http</javax.xml.accessExternalDTD>
                        <javax.xml.accessExternalStylesheet>all</javax.xml.accessExternalStylesheet>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>run-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <phase>integration-test</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        Exactly one of these runs the TCK: glassfish (the default), glassfish-embedded, quarkus, quarkus-native,
        piranha-micro or piranha-webprofile, chosen with -P. Each makes the Derby client driver available to the pages.
        The two Quarkus profiles differ only in arquillian.quarkus.nativeImage.
    -->
    <profiles>
        <!-- Builds each test archive into a Quarkus application in JVM mode: mvn verify -Pquarkus -->
        <profile>
            <id>quarkus</id>
            <properties>
                <arquillian-quarkus.version>1.1.1</arquillian-quarkus.version>
            </properties>
            <dependencies>
                <!-- The Arquillian connector that builds each archive into a Quarkus application and runs it -->
                <dependency>
                    <groupId>ee.omnifish.arquillian</groupId>
                    <artifactId>arquillian-quarkus-managed</artifactId>
                    <version>${arquillian-quarkus.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- The extensions and libraries the test applications are built with -->
                                <arquillian.quarkus.dependencies>
                                    org.glassfish.wasp:quarkus-wasp:${wasp.version}
                                    org.apache.derby:derbyclient:${derby.version}
                                </arquillian.quarkus.dependencies>
                                <!--
                                    Quarkus defaults to UTF-8 for requests and responses; the Servlet default, which
                                    the TCK checks for pages without a page encoding or content type, is ISO-8859-1.
                                -->
                                <arquillian.quarkus.buildProperties>
                                    quarkus.servlet.default-charset=ISO-8859-1
                                </arquillian.quarkus.buildProperties>
                                <!-- For the JAXP properties, see the failsafe configuration above -->
                                <arquillian.quarkus.systemProperties>
                                    javax.xml.accessExternalDTD=file,http
                                    javax.xml.accessExternalStylesheet=all
                                </arquillian.quarkus.systemProperties>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Builds each test archive into a native executable: mvn verify -Pquarkus-native. Needs GraalVM or Mandrel,
            from GRAALVM_HOME or as the JDK that runs Maven. A native build takes a minute or more per test class.
        -->
        <profile>
            <id>quarkus-native</id>
            <properties>
                <arquillian-quarkus.version>1.1.1</arquillian-quarkus.version>
                <!--
                    The TCK's JstlDbFilter refers to Ant's StringUtils (to escape a comma in the database URL), which
                    its archives don't include. A JVM never loads it, as the URL has no comma, but a native image
                    build links at build time and fails without it. The version the TCK itself depends on.
                -->
                <ant.version>1.10.15</ant.version>
            </properties>
            <dependencies>
                <!-- The Arquillian connector that builds each archive into a Quarkus application and runs it -->
                <dependency>
                    <groupId>ee.omnifish.arquillian</groupId>
                    <artifactId>arquillian-quarkus-managed</artifactId>
                    <version>${arquillian-quarkus.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- The extensions and libraries the test applications are built with -->
                                <arquillian.quarkus.dependencies>
                                    org.glassfish.wasp:quarkus-wasp:${wasp.version}
                                    org.apache.derby:derbyclient:${derby.version}
                                    org.apache.ant:ant:${ant.version}
                                </arquillian.quarkus.dependencies>
                                <!--
                                    Quarkus defaults to UTF-8 for requests and responses; the Servlet default, which
                                    the TCK checks for pages without a page encoding or content type, is ISO-8859-1.
                                -->
                                <!--
                                    As an application would decide: all locales, as the formatting tests use many
                                    (Quarkus includes only the default one), and the bundles that pages name with an
                                    expression, e.g. basename="...resources.${param.res}" (the extension registers
                                    those named literally).
                                -->
                                <arquillian.quarkus.buildProperties>
                                    quarkus.servlet.default-charset=ISO-8859-1
                                    quarkus.locales=all
                                    quarkus.native.additional-build-args=-H:+UnlockExperimentalVMOptions,\
                                        -H:IncludeResourceBundles=com.sun.ts.tests.jstl.common.resources.AlgoResources,\
                                        -H:IncludeResourceBundles=com.sun.ts.tests.jstl.common.resources.AlgoResources2,\
                                        -H:IncludeResourceBundles=com.sun.ts.tests.jstl.common.resources.AlgoResources3,\
                                        -H:IncludeResourceBundles=com.sun.ts.tests.jstl.common.resources.AlgoResources4,\
                                        -H:IncludeResourceBundles=com.sun.ts.tests.jstl.common.resources.AlgoResources5,\
                                        -H:-UnlockExperimentalVMOptions
                                </arquillian.quarkus.buildProperties>
                                <!-- For the JAXP properties, see the failsafe configuration above -->
                                <arquillian.quarkus.systemProperties>
                                    javax.xml.accessExternalDTD=file,http
                                    javax.xml.accessExternalStylesheet=all
                                </arquillian.quarkus.systemProperties>

                                <arquillian.quarkus.nativeImage>true</arquillian.quarkus.nativeImage>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Runs the TCK on GlassFish (the full distribution, version glassfish.version), with the WaSP jar GlassFish
            ships replaced by this build's (org.glassfish.wasp:wasp:wasp.version, installed by building WaSP):
            mvn verify. GlassFish is unpacked once into target; the WaSP jar is copied in at every run. GlassFish comes
            with the Derby client driver. Build and install WaSP first (mvn install in the WaSP root), as this takes its
            jar from the local repository.
        -->
        <profile>
            <id>glassfish</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <arquillian-glassfish.version>2.2.1</arquillian-glassfish.version>
                <glassfish.version>8.0.5</glassfish.version>
                <glassfish.root>${project.build.directory}</glassfish.root>
                <glassfish.home>${glassfish.root}/glassfish8</glassfish.home>
            </properties>
            <dependencies>
                <!-- The Arquillian connector that starts GlassFish and deploys archives to it -->
                <dependency>
                    <groupId>ee.omnifish.arquillian</groupId>
                    <artifactId>arquillian-glassfish-server-managed</artifactId>
                    <version>${arquillian-glassfish.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!--
                        GlassFish keeps its own copy of each module in its OSGi cache, and only refreshes it for a
                        newer module jar. The copied WaSP jar keeps its build time, so drop the cache instead.
                    -->
                    <plugin>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.4.1</version>
                        <executions>
                            <execution>
                                <id>clear-osgi-cache</id>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <phase>generate-test-resources</phase>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${glassfish.home}/glassfish/domains/domain1/osgi-cache</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>unpack-glassfish</id>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <phase>generate-test-resources</phase>
                                <configuration>
                                    <markersDirectory>${glassfish.root}/dependency-maven-plugin-markers</markersDirectory>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>org.glassfish.main.distributions</groupId>
                                            <artifactId>glassfish</artifactId>
                                            <version>${glassfish.version}</version>
                                            <type>zip</type>
                                            <overWrite>false</overWrite>
                                            <outputDirectory>${glassfish.root}</outputDirectory>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Runs after the unpacking, as it's bound to the same phase and declared later -->
                                <id>replace-wasp</id>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <phase>generate-test-resources</phase>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>org.glassfish.wasp</groupId>
                                            <artifactId>wasp</artifactId>
                                            <version>${wasp.version}</version>
                                            <overWrite>true</overWrite>
                                            <outputDirectory>${glassfish.home}/glassfish/modules</outputDirectory>
                                            <destFileName>wasp.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <glassfish.home>${glassfish.home}</glassfish.home>

                                <!-- For the JAXP properties, see the failsafe configuration above -->
                                <glassfish.postBootCommands>
                                    set server-config.network-config.protocols.protocol.http-listener-1.http.trace-enabled=true
                                    create-system-properties javax.xml.accessExternalDTD=file,http:javax.xml.accessExternalStylesheet=all
                                </glassfish.postBootCommands>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Runs the TCK on Piranha Micro (version piranha.version), in process: each test archive is deployed to a
            Piranha Micro of its own, in the JVM of the tests: mvn verify -Ppiranha-micro. Micro resolves its jars when
            it starts, with the WaSP jar it comes with replaced by this build's (org.glassfish.wasp:wasp:wasp.version,
            installed by building WaSP), and with the Derby client driver, which it doesn't come with. Its WaSP
            extension provides the Jakarta Tags API. It resolves them from the local repository only, so build and
            install Piranha first (mvn install in the Piranha root), as piranha.version is a snapshot.
        -->
        <profile>
            <id>piranha-micro</id>
            <properties>
                <piranha.version>25.4.0-SNAPSHOT</piranha.version>
            </properties>
            <dependencies>
                <!-- The Arquillian connector that starts a Piranha Micro for each archive, in the JVM of the tests -->
                <dependency>
                    <groupId>cloud.piranha.arquillian</groupId>
                    <artifactId>piranha-arquillian-server</artifactId>
                    <version>${piranha.version}</version>
                    <scope>test</scope>
                </dependency>
                <!--
                    Piranha compiles pages against the class path of the JVM it runs in, here that of the tests, so
                    the WaSP jar Micro uses must be on it too. Micro itself doesn't load classes from it.
                -->
                <dependency>
                    <groupId>org.glassfish.wasp</groupId>
                    <artifactId>wasp</artifactId>
                    <version>${wasp.version}</version>
                    <scope>test</scope>
                </dependency>
                <!-- The Maven resolver Micro resolves its jars with, which the connector doesn't bring itself -->
                <dependency>
                    <groupId>org.jboss.shrinkwrap.resolver</groupId>
                    <artifactId>shrinkwrap-resolver-depchain</artifactId>
                    <version>3.3.7</version>
                    <type>pom</type>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- Piranha writes the compiled pages to tmp in the working directory -->
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <systemPropertyVariables>
                                <!-- Replaces the WaSP version Micro comes with, and adds the Derby client driver -->
                                <piranha.dependencies>org.glassfish.wasp:wasp:${wasp.version},org.apache.derby:derbyclient:${derby.version}</piranha.dependencies>
                                <piranha.offline>true</piranha.offline>
                                <!-- The TCK requests each archive's pages at the archive's name -->
                                <piranha.rootIsWarName>true</piranha.rootIsWarName>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Runs the TCK on the Piranha Web Profile distribution (version piranha.version), with each test archive
            deployed to a Piranha process of its own: mvn verify -Ppiranha-webprofile. The distribution is a single jar
            with WaSP 4.0.0 and the Jakarta Tags API inside. This build's WaSP jar comes before it on the class path, so
            its classes and tag library descriptors are found first. The Derby client driver is on it too. The
            distribution is taken from the local repository, so build and install Piranha first (mvn install in the
            Piranha root), as piranha.version is a snapshot.
        -->
        <profile>
            <id>piranha-webprofile</id>
            <properties>
                <piranha.version>25.4.0-SNAPSHOT</piranha.version>
                <piranha.root>${project.build.directory}/piranha</piranha.root>
            </properties>
            <dependencies>
                <!-- The Arquillian connector that starts Piranha as a process for each archive and deploys it there -->
                <dependency>
                    <groupId>cloud.piranha.arquillian</groupId>
                    <artifactId>piranha-arquillian-managed</artifactId>
                    <version>${piranha.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-jars</id>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <phase>generate-test-resources</phase>
                                <configuration>
                                    <outputDirectory>${piranha.root}</outputDirectory>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                    <stripVersion>true</stripVersion>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>org.glassfish.wasp</groupId>
                                            <artifactId>wasp</artifactId>
                                            <version>${wasp.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>org.apache.derby</groupId>
                                            <artifactId>derbyclient</artifactId>
                                            <version>${derby.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>org.apache.derby</groupId>
                                            <artifactId>derbyshared</artifactId>
                                            <version>${derby.version}</version>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <piranha.distribution>webprofile</piranha.distribution>
                                <!--
                                    With a class path, the connector starts Piranha with it before Piranha's jar. The
                                    logging configuration keeps Piranha from logging everything, at each request. For
                                    the JAXP properties, see the failsafe configuration above.
                                -->
                                <piranha.jvmArguments>
                                    -cp ${piranha.root}/wasp.jar:${piranha.root}/derbyclient.jar:${piranha.root}/derbyshared.jar
                                    -Djava.util.logging.config.file=${project.basedir}/src/test/piranha/logging.properties
                                    -Djavax.xml.accessExternalDTD=file,http
                                    -Djavax.xml.accessExternalStylesheet=all
                                </piranha.jvmArguments>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Runs the TCK on GlassFish Embedded (version glassfish.version), in the JVM of the tests: mvn verify
            -Pglassfish-embedded. GlassFish Embedded is a single jar with its own copy of WaSP inside. This build's WaSP
            jar comes before it on the class path, so its classes and tag library descriptors are found first. That
            jar has every WaSP file GlassFish Embedded has, so no class of GlassFish's own WaSP is used. The Derby
            client driver is on the class path of the tests.
        -->
        <profile>
            <id>glassfish-embedded</id>
            <properties>
                <arquillian-glassfish.version>2.2.1</arquillian-glassfish.version>
                <glassfish.version>8.0.5</glassfish.version>
            </properties>
            <dependencies>
                <!-- Before glassfish-embedded-all, so that this build's WaSP classes are found before GlassFish's -->
                <dependency>
                    <groupId>org.glassfish.wasp</groupId>
                    <artifactId>wasp</artifactId>
                    <version>${wasp.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.glassfish.main.extras</groupId>
                    <artifactId>glassfish-embedded-all</artifactId>
                    <version>${glassfish.version}</version>
                    <scope>test</scope>
                </dependency>
                <!-- The Arquillian connector that starts GlassFish Embedded and deploys archives to it -->
                <dependency>
                    <groupId>ee.omnifish.arquillian</groupId>
                    <artifactId>arquillian-glassfish-server-embedded</artifactId>
                    <version>${arquillian-glassfish.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <glassfish.postBootCommands>
                                    set server-config.network-config.protocols.protocol.http-listener-1.http.trace-enabled=true
                                </glassfish.postBootCommands>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
