<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee" version="3.0">
    <tlib-version>1.0</tlib-version>
    <short-name>test</short-name>
    <uri>urn:wasp:test</uri>
    <listener><listener-class>org.glassfish.wasp.quarkus.test.TagLibraryListener</listener-class></listener>
    <tag>
        <name>shout</name>
        <tag-class>org.glassfish.wasp.quarkus.test.ShoutTag</tag-class>
        <body-content>empty</body-content>
        <attribute><name>text</name><required>true</required><rtexprvalue>true</rtexprvalue></attribute>
    </tag>
</taglib>
